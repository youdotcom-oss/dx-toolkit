{
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["error", "log"]
              }
            }
          }
        }
      }
    }
  ]
}
